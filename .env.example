# Port Nest listens on. The frontend's NEXT_PUBLIC_API_URL must point here.
PORT=8000

# Where GET /auth/google/redirect sends the browser after successful OAuth.
FRONTEND_URL="http://localhost:3000"

# Google OAuth. The callback URL must also be registered as an
# "Authorized redirect URI" in Google Cloud Console -> Credentials.
GOOGLE_CALLBACK_URL="http://localhost:8000/auth/google/redirect"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# JWT signing + lifetimes.
JWT_SECRET=""
JWT_ACCESS_TOKEN_TTL="1h"
JWT_REFRESH_TOKEN_TTL_DAYS="3"

# MongoDB connection string.
MONGO_URL=""

# SMTP used for password-reset links and email verification codes.
NODEMAILER_HOST="smtp.gmail.com"
NODEMAILER_PORT="587"
NODEMAILER_USER=""
NODEMAILER_PASS=""
